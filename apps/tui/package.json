{
  "name": "@clite/tui",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Terminal UI for C-lite. Talks to the Python backend over JSON-RPC on stdio.",
  "bin": {
    "clite-tui": "./dist/clite-tui.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test test/*.test.ts",
    "build": "node build.mjs",
    "dev": "node build.mjs && node dist/clite-tui.mjs"
  },
  "devDependencies": {
    "@clite/shared": "*",
    "@types/node": ">=26",
    "@types/react": "^19.3.0",
    "esbuild": ">=0.25 <1",
    "ink": "^8.0.0",
    "react": "^19.3.0",
    "typescript": ">=5.8 <8"
  }
}
